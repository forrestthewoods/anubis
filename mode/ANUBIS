# Static C/C++ runtime: self-contained executables (no runtime DLLs/.so to
# ship), but heap-owning C++ objects and exceptions can't cross a shared
# library boundary.

mode(
    name = "win_dev_static",
    vars = {
        target_platform = "windows",
        target_arch = "x64",
        build_type = "debug",
        runtime_linkage = "static",
    },
)

mode(
    name = "win_release_static",
