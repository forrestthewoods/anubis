# Static C/C++ runtime: self-contained executables (no runtime DLLs/.so to
# ship), but heap-owning C++ objects and exceptions can't cross a shared
# library boundary.

mode(
    name = "win_dev_static",
    vars = {
        target_platform = "windows",
        target_arch = "x64",
        build_type = "debug",
        runtime_linkage = "static",
    },
)

mode(
    name = "win_release_static",
    vars = {
        target_platform = "windows",
        target_arch = "x64",
        build_type = "release",
        runtime_linkage = "static",
    },
)

mode(
    name = "linux_dev_static",
    vars = {
        target_platform = "linux",
        target_arch = "x64",
        build_type = "debug",
        runtime_linkage = "static",
    },
)

mode(
    name = "linux_release_static",
    vars = {
        target_platform = "linux",
        target_arch = "x64",
        build_type = "release",
        runtime_linkage = "static",
    },
)

# macOS on Apple silicon (arm64 only; Intel Macs aren't supported). Built
# from any host with the SDK Natron fetches (`macos_sdk` in natron.toml).
# The C++ runtime is the system's libc++, so there is no static variant.

mode(
    name = "macos_dev",
    vars = {
        target_platform = "macos",
        target_arch = "arm64",
        build_type = "debug",
        runtime_linkage = "dynamic",
    },
)

mode(
    name = "macos_release",
    vars = {
        target_platform = "macos",
        target_arch = "arm64",
        build_type = "release",
        runtime_linkage = "dynamic",
    },
)
