# C calling NASM: one function from a nasm_static_library, one from
# nasm_objects linked straight into the binary. NASM is x86 only, so arm64
# targets (macOS) take the same functions from a clang-assembled .S file.
cc_binary(
    name = "main",
    lang = "c",
    srcs = [ RelPath("main.c") ] + select(
        (target_arch) => {
            (arm64) = [ RelPath("asm/arm64.S") ],
            default = [],
        }
    ),
    deps = select(
        (target_arch) => {
            (x64) = Targets([ ":answer", ":twice" ]),
            default = [],
        }
    ),
)

nasm_static_library(
    name = "answer",
    srcs = [ RelPath("asm/answer.asm") ],
    include_dirs = [ RelPath("asm") ],
    headers = RelPaths([ "asm/abi.inc", "asm/answer.inc" ]),
)

nasm_objects(
    name = "twice",
    srcs = [ RelPath("asm/twice.asm") ],
    preincludes = [ RelPath("asm/abi.inc") ],
)

# The sample's sources as a zip and a 7z. They need no mode:
#   anubis build -t //samples/basic/nasm_c:src //samples/basic/nasm_c:src_7z
archive_zip(
    name = "src",
    srcs = glob([ "*.c", "asm/*", "ANUBIS" ]),
    prefix = "nasm_c",
)

archive_7z(
    name = "src_7z",
    srcs = glob([ "*.c", "asm/*", "ANUBIS" ]),
    prefix = "nasm_c",
    level = 9,
)
