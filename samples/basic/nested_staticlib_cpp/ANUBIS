# Nested static library example demonstrating diamond dependency pattern:
#
#       main
#      /    \
#    foo    bar
#      \    /
#       util
#
# Both foo and bar depend on util, but util should only be built once.
# This verifies that issue #18's duplicate prevention works correctly.
#
# This example also demonstrates the Targets() syntax for relative dependencies,
# and that public args propagate transitively (util's define reaches main).

cc_binary(
    name = "main",
    lang = "cpp",
    srcs = [RelPath("src/main.cpp")],
    deps = Targets([":bar", ":foo"]),
)

cc_static_library(
    name = "foo",
    lang = "cpp",
    srcs = [RelPath("src/foo.cpp")],
    public_include_dirs = [RelPath("include")],
    deps = Targets([":util"]),
)

cc_static_library(
    name = "bar",
    lang = "cpp",
    srcs = [RelPath("src/bar.cpp")],
    public_include_dirs = [RelPath("include")],
    deps = Targets([":util"]),
)

cc_static_library(
    name = "util",
    lang = "cpp",
    srcs = [RelPath("src/util.cpp")],
    public_include_dirs = [RelPath("include")],
    # main does not depend on util directly; this must still reach it.
    public_defines = ["UTIL_TRANSITIVE_DEFINE=1"],
    deps = Targets([]),
)
