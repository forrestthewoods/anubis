# main -> greet (shared) -> calc (shared)
#                        -> util (static, linked into greet only)
cc_binary(
    name = "main",
    lang = "cpp",
    srcs = [ RelPath("src/main.cpp") ],
    deps = Targets([ ":calc", ":greet" ]),
)

cc_shared_library(
    name = "greet",
    lang = "cpp",
    srcs = [ RelPath("src/greet.cpp") ],
    public_include_dirs = [ RelPath("include") ],
    public_headers = [ RelPath("include/greet.h") ],
    private_defines = [ "GREET_BUILDING" ],
    # C++ types and exceptions cross the boundary only with a shared runtime.
    public_defines = select(
        (runtime_linkage) => {
            (dynamic) = [ "SAMPLE_SHARED_RUNTIME" ],
            (static) = [],
        }
    ),
    deps = Targets([ ":calc", ":util" ]),
)

cc_shared_library(
    name = "calc",
    lang = "cpp",
    srcs = [ RelPath("src/calc.cpp") ],
    public_include_dirs = [ RelPath("include") ],
    public_headers = [ RelPath("include/calc.h"), RelPath("include/export.h") ],
    private_defines = [ "CALC_BUILDING" ],
)

cc_static_library(
    name = "util",
    lang = "cpp",
    srcs = [ RelPath("src/util.cpp") ],
    public_include_dirs = [ RelPath("include") ],
    public_headers = [ RelPath("include/util.h") ],
)
