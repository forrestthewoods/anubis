# Toolchain binaries are installed into this directory from natron.toml at
# the repo root (`anubis install-toolchains`). The layout is the same on
# every host: llvm/, zig/, nasm/, msvc/, windows_kits/.

toolchain(
    name = "default",
    build_mode = select(
        (build_platform) => {
            (windows) = Target("//mode:win_release"),
            (linux) = Target("//mode:linux_release"),
        }
    ),
    c = CcToolchain(
        compiler = select(
            (build_platform, build_arch) => {
                (windows, x64) = RelPath("llvm/bin/clang.exe"),
                (linux, x64) = RelPath("llvm/bin/clang"),
            }
        ),
        linker = select(
            (build_platform, build_arch, target_platform) => {
                (windows, x64, windows) = RelPath("llvm/bin/lld-link.exe"),
                (windows, x64, linux) = RelPath("llvm/bin/ld.lld.exe"),
                (linux, x64, windows) = RelPath("llvm/bin/lld-link"),
                (linux, x64, linux) = RelPath("llvm/bin/ld.lld"),
            }
        ),
        archiver = select(
            (build_platform, build_arch) => {
                (windows, x64) = RelPath("llvm/bin/llvm-ar.exe"),
                (linux, x64) = RelPath("llvm/bin/llvm-ar"),
            }
        ),
        compiler_flags = [
            # strip away most clang defaults
            "-nostdinc",
            "-nostdlib",
            "-nodefaultlibs",
            "-isysroot=./empty_dir",

            # miscellaneous
            "-MD", # generate .d depenendency file including system headers

            # CPU / SIMD
            "-mstackrealign",               # safe stack alignment for SSE/AVX
            "-mfpmath=sse",                 # x64 ABI
            "-msse2",                       # simd instrinsic support
            "-msse3",
            "-mssse3",
            "-msse4.1",
            "-msse4.2",
            "-mavx",
        ] + select(
            (target_platform, target_arch) => {
                (windows, x64) = [
                    "-target", "x86_64-pc-windows-msvc",
                ] + select(
                    # Which MSVC C runtime (and C++ standard library) to
                    # build against. Sets _MT/_DLL/_DEBUG and the default
                    # libraries recorded in each object.
                    (runtime_linkage, build_type) => {
                        (dynamic, debug) = [ "-fms-runtime-lib=dll_dbg" ],
                        (dynamic, release) = [ "-fms-runtime-lib=dll" ],
                        (static, debug) = [ "-fms-runtime-lib=static_dbg" ],
                        (static, release) = [ "-fms-runtime-lib=static" ],
                    }
                ),
                (linux, x64) = [
                    "-target", "x86_64-linux-gnu",
                    "-mlong-double-80",         # Linux x86-64 ABI uses 80-bit long double
                    "-fPIC",                    # any object may end up in a shared library
                ],
            }
        ) + select(
            (build_type) => {
                (debug) = [
                    "-O0",                      # no optimization for debug
                    "-g",                       # generate debug info
                    "-fno-omit-frame-pointer",  # preserve frame pointers for debugging
                ],
                (release) = [
                    "-O2",                      # optimization for release
                    "-g",                       # debug info (can be stripped later)
                ],
            }
        ),
        linker_flags = select(
            (target_platform, target_arch) => {
                (windows, x64) = [
                    "-Wl,/DEBUG",  # generate PDB file
                ],
                (linux, x64) = [
                    "--dynamic-linker=/lib64/ld-linux-x86-64.so.2",
                    "--allow-shlib-undefined",
                    # PT_GNU_EH_FRAME, which the unwinder uses to find FDEs.
                    # clang's driver adds this; calling ld.lld directly must
                    # too, or every C++ throw terminates uncaught.
                    "--eh-frame-hdr",
                ],
            }
        ),
        library_dirs = select(
            (target_platform, target_arch) => {
                (windows, x64) = [
                    RelPath("msvc/VC/Tools/MSVC/14.50.35717/lib/x64"),
                    RelPath("windows_kits/Lib/10.0.26100.0/um/x64"),
